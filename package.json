{
  "name": "cinema-reservations-api",
  "version": "1.0.0",
  "description": "API REST de reservas para un cine, desarrollada con Node.js y TypeScript.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --root .",
    "test:unit": "vitest run --root . --project unit",
    "test:integration": "vitest run --root . --project integration",
    "test:concurrency": "vitest run --root . --project concurrency",
    "test:db:prepare": "tsx tests/scripts/prepare-test-db.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariela1217/cinema-reservations-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mariela1217/cinema-reservations-api/issues"
  },
  "homepage": "https://github.com/mariela1217/cinema-reservations-api#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.19.3",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
