// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(200)
  duration_minutes Int
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  showtimes Showtime[]
  @@map("movies")
}

enum SeatType {
  REGULAR
  VIP
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  seats Seat[]
  showtimes Showtime[]

  @@map("rooms")
}

model Seat {
  id          String   @id @default(uuid()) @db.Uuid
  room_id     String   @db.Uuid
  row_label   String   @db.VarChar(5)
  seat_number Int
  type        SeatType @default(REGULAR)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  room Room @relation(fields: [room_id], references: [id], onDelete: Restrict)

  @@unique([room_id, row_label, seat_number])
  reservation_seats ReservationSeat[]
  @@map("seats")
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED
}

model Showtime {
  id               String         @id @default(uuid()) @db.Uuid
  movie_id         String         @db.Uuid
  room_id          String         @db.Uuid
  starts_at        DateTime       @db.Timestamptz(6)
  ends_at          DateTime       @db.Timestamptz(6)
  base_price_cents Int
  status           ShowtimeStatus @default(SCHEDULED)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @updatedAt @db.Timestamptz(6)

  movie Movie @relation(fields: [movie_id], references: [id], onDelete: Restrict)
  room  Room  @relation(fields: [room_id], references: [id], onDelete: Restrict)

  @@index([movie_id, starts_at])
  @@index([room_id, starts_at])
  reservations Reservation[]
  reservation_seats ReservationSeat[]
  @@map("showtimes")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum ReservationStatusReason {
  CREATED
  CONFIRMED_BY_CUSTOMER
  CANCELLED_BY_CUSTOMER
  SHOWTIME_CANCELLED
  PAYMENT_TIMEOUT
}
model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  showtime_id    String            @db.Uuid
  customer_name  String            @db.VarChar(150)
  customer_email String            @db.VarChar(254)
  status         ReservationStatus @default(PENDING)
  total_cents    Int
  expires_at     DateTime?         @db.Timestamptz(6)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @updatedAt @db.Timestamptz(6)

  showtime Showtime @relation(fields: [showtime_id], references: [id], onDelete: Restrict)
  reservation_seats ReservationSeat[]
  status_history ReservationStatusHistory[]
  @@index([status, expires_at])
  @@map("reservations")
}

model ReservationSeat {
  id             String   @id @default(uuid()) @db.Uuid
  reservation_id String   @db.Uuid
  seat_id        String   @db.Uuid
  showtime_id    String   @db.Uuid
  price_cents    Int
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservation_id], references: [id], onDelete: Restrict)
  seat        Seat        @relation(fields: [seat_id], references: [id], onDelete: Restrict)
  showtime    Showtime    @relation(fields: [showtime_id], references: [id], onDelete: Restrict)

  @@unique([reservation_id, seat_id])
  @@index([showtime_id, seat_id])
  @@map("reservation_seats")
}

model ReservationStatusHistory {
  id             String                   @id @default(uuid()) @db.Uuid
  reservation_id String                   @db.Uuid
  from_status    ReservationStatus?
  to_status      ReservationStatus
  reason         ReservationStatusReason
  changed_at     DateTime                 @default(now()) @db.Timestamptz(6)

  reservation Reservation @relation(fields: [reservation_id], references: [id], onDelete: Restrict)

  @@index([reservation_id, changed_at])
  @@map("reservation_status_history")
}